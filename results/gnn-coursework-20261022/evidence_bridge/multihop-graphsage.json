  "knowledge": [
    {
      "id": "rule-log-correlation",
      "title": "Log timestamps and optional trace fields",
      "text": "Timestamp records when an event occurred; ObservedTimestamp records when collection observed it. TraceId and SpanId are optional correlation fields. Resource identifies the source entity; Body and Attributes carry event content.",
      "source_url": "https://opentelemetry.io/docs/specs/otel/logs/data-model/",
      "source_section": "Log and Event Record Definition; Trace Context Fields",
      "source_version": "OpenTelemetry specification 1.61.0; reviewed 2026-10-13",
      "kind": "general_rule",
      "services": [],
      "operations": [],
      "entity_ids": [],
      "scope": "Telemetry interpretation across authorized services; apply the producer's actual convention version",
      "rule_status": "documented",
      "text_kind": "paraphrase",
      "application_limit": "Keep event time distinct from collection time. Similar wording or nearby timestamps alone do not establish a shared request.",
      "reviewed_on": "2026-10-13",
      "text_sha256": "9ee8acbdd542734c933cd08d109da6e7b23f754bba28097c123e2e7248558531"
    },
    {
      "id": "shop-payment-handler",
      "title": "Payment handler records and returns failures",
      "text": "The PaymentService handler calls the charge implementation. If it throws, the handler logs the error, marks its active span ERROR, sets error.type, and returns the error through the RPC callback.",
      "source_url": "https://github.com/open-telemetry/opentelemetry-demo/blob/dedc0178918e260823323b8d95005a8cb924b007/src/payment/index.js#L12-L31",
