  {
    "statement": "MATCH (c:ATKnowledge:Chunk {graph_id:$graph}) WHERE c.kind=\"general_rule\" OR any(s IN c.services WHERE s IN $services) RETURN properties(c) AS chunk ORDER BY c.id LIMIT 300",
    "parameters": {
