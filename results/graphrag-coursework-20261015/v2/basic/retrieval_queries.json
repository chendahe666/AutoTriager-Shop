        "payment"
      ]
    },
    "rows": [
      {
        "chunk": {
          "text_kind": "paraphrase",
          "kind": "general_rule",
          "services": [],
          "graph_id": "autotriager-rag-v1",
          "title": "Error classification depends on the operation",
          "source_url": "https://opentelemetry.io/docs/specs/semconv/general/recording-errors/",
          "rule_status": "documented",
          "source_version": "semantic-conventions 1.44.0; development guidance; reviewed 2026-10-13",
          "application_limit": "This development guidance is interpretation context, not a guarantee that historical instrumentation complied with it.",
          "operations": [],
          "text_sha256": "f54d7fefa29c4032842b4d976d69cf02984144299188297baf9ef6681a41dc8b",
          "scope": "Telemetry interpretation across authorized services; apply the producer's actual convention version",
          "corpus_id": "autotriager-incident-rag-v1",
          "id": "rule-error-context",
          "text": "An error code needs operation context: even HTTP 404 may be expected when checking existence. Current guidance says handled or retried errors should not mark an overall operation as failed when it completes gracefully.",
          "reviewed_on": "2026-10-13",
          "entity_ids": [],
          "source_section": "What constitutes an error"
        }
      },
      {
        "chunk": {
          "text_kind": "paraphrase",
          "kind": "general_rule",
          "services": [],
          "graph_id": "autotriager-rag-v1",
          "title": "Log timestamps and optional trace fields",
          "source_url": "https://opentelemetry.io/docs/specs/otel/logs/data-model/",
          "rule_status": "documented",
          "source_version": "OpenTelemetry specification 1.61.0; reviewed 2026-10-13",
          "application_limit": "Keep event time distinct from collection time. Similar wording or nearby timestamps alone do not establish a shared request.",
          "operations": [],
          "text_sha256": "9ee8acbdd542734c933cd08d109da6e7b23f754bba28097c123e2e7248558531",
          "scope": "Telemetry interpretation across authorized services; apply the producer's actual convention version",
          "corpus_id": "autotriager-incident-rag-v1",
          "id": "rule-log-correlation",
          "text": "Timestamp records when an event occurred; ObservedTimestamp records when collection observed it. TraceId and SpanId are optional correlation fields. Resource identifies the source entity; Body and Attributes carry event content.",
          "reviewed_on": "2026-10-13",
          "entity_ids": [],
          "source_section": "Log and Event Record Definition; Trace Context Fields"
        }
      },
      {
        "chunk": {
          "text_kind": "paraphrase",
          "kind": "general_rule",
          "services": [],
          "graph_id": "autotriager-rag-v1",
          "title": "A derived claim needs a source trail",
          "source_url": "https://www.w3.org/TR/2013/REC-prov-o-20130430/",
          "rule_status": "documented",
          "source_version": "W3C recommendation 2013-04-30; reviewed 2026-10-13",
          "application_limit": "AutoTriager uses these ideas for traceable evidence. A citation proves source identity only after resolution; it does not by itself prove that a claim is supported.",
          "operations": [],
          "text_sha256": "745132821ba749c51534e01839363406fe2be2cbf866ada11d80427af2d2bd2c",
          "scope": "Telemetry interpretation across authorized services; apply the producer's actual convention version",
          "corpus_id": "autotriager-incident-rag-v1",
          "id": "rule-provenance",
          "text": "PROV-O distinguishes entities, activities, and agents. Derivation connects an entity to material used to construct it; qualified derivation can describe the producing activity in more detail.",
          "reviewed_on": "2026-10-13",
          "entity_ids": [],
          "source_section": "3.1 Starting Point Terms; 4.3 Qualified Terms"
        }
      },
      {
        "chunk": {
          "text_kind": "paraphrase",
          "kind": "general_rule",
          "services": [],
          "graph_id": "autotriager-rag-v1",
          "title": "RPC method, outcome, and convention version",
          "source_url": "https://opentelemetry.io/docs/specs/semconv/rpc/rpc-spans/",
          "rule_status": "documented",
          "source_version": "semantic-conventions 1.44.0; RPC release candidate; reviewed 2026-10-13",
          "application_limit": "Interpret original field names under their producer's convention version; do not assume a timeout proves a server-side code failure.",
          "operations": [],
          "text_sha256": "35878216382527630df8f145d2689d70f88678c5b7526b072b4a58564f59feb1",
          "scope": "Telemetry interpretation across authorized services; apply the producer's actual convention version",
          "corpus_id": "autotriager-incident-rag-v1",
          "id": "rule-rpc-context",
          "text": "RPC spans describe remote calls with method and outcome information. Client-side duration can include retries. The current conventions distinguish errors occurring before a response from returned error status codes and document migration behavior for older instrumentation.",
          "reviewed_on": "2026-10-13",
          "entity_ids": [],
          "source_section": "RPC client span; migration notice; error.type"
        }
      },
      {
        "chunk": {
          "text_kind": "paraphrase",
          "kind": "general_rule",
          "services": [],
          "graph_id": "autotriager-rag-v1",
          "title": "Logical service and instance identity",
          "source_url": "https://opentelemetry.io/docs/specs/semconv/resource/service/",
          "rule_status": "documented",
          "source_version": "semantic-conventions 1.44.0; reviewed 2026-10-13",
          "application_limit": "Do not merge different namespaces or infer that two records came from the same replica from service.name alone.",
          "operations": [],
          "text_sha256": "67bd7133eecfe2c0746b6d4ea2867f00abb3e64a5ef5e5c09db6f1edeec08617",
          "scope": "Telemetry interpretation across authorized services; apply the producer's actual convention version",
          "corpus_id": "autotriager-incident-rag-v1",
          "id": "rule-service-identity",
          "text": "service.name identifies a logical service; service.namespace disambiguates groups. service.instance.id distinguishes its running instances. Several replicas may share one service.name.",
          "reviewed_on": "2026-10-13",
          "entity_ids": [],
          "source_section": "Service, Service Instance, Service Namespace"
        }
      },
      {
        "chunk": {
          "text_kind": "paraphrase",
          "kind": "general_rule",
          "services": [],
          "graph_id": "autotriager-rag-v1",
          "title": "Service version is a separate attribute",
          "source_url": "https://opentelemetry.io/docs/specs/semconv/resource/service/",
          "rule_status": "documented",
          "source_version": "semantic-conventions 1.44.0; reviewed 2026-10-13",
          "application_limit": "A source commit and a telemetry service-name match do not establish deployed-source equality.",
          "operations": [],
          "text_sha256": "ce5c1009800d465eb5458fbffd00f4c7c7277fcf883476794cb9cfcdc192c93f",
          "scope": "Telemetry interpretation across authorized services; apply the producer's actual convention version",
          "corpus_id": "autotriager-incident-rag-v1",
          "id": "rule-service-version",
          "text": "service.version describes the component version, and its format is not standardized. The logical service name alone does not identify the version.",
          "reviewed_on": "2026-10-13",
          "entity_ids": [],
          "source_section": "Service attributes: service.version"
        }
      },
      {
        "chunk": {
          "text_kind": "paraphrase",
          "kind": "general_rule",
          "services": [],
          "graph_id": "autotriager-rag-v1",
          "title": "Client, server, and internal spans",
          "source_url": "https://opentelemetry.io/docs/specs/otel/trace/api/",
          "rule_status": "documented",
          "source_version": "OpenTelemetry specification 1.61.0; reviewed 2026-10-13",
          "application_limit": "Separate the emitting service from the service being called. Span kinds describe execution roles, not fault responsibility.",
          "operations": [],
          "text_sha256": "8d94a0c62899d9509a3d9f5384bed69865787d5612caf18306d191bc1f877494",
          "scope": "Telemetry interpretation across authorized services; apply the producer's actual convention version",
          "corpus_id": "autotriager-incident-rag-v1",
          "id": "rule-span-direction",
          "text": "CLIENT spans describe outgoing requests; SERVER spans describe incoming request handling. INTERNAL spans describe work inside an application. Context propagation commonly makes a remote SERVER span a child of a CLIENT span; nested CLIENT spans are also possible.",
          "reviewed_on": "2026-10-13",
          "entity_ids": [],
          "source_section": "SpanKind"
        }
      },
      {
        "chunk": {
          "text_kind": "paraphrase",
          "kind": "general_rule",
          "services": [],
          "graph_id": "autotriager-rag-v1",
          "title": "Error and unset span status",
          "source_url": "https://opentelemetry.io/docs/specs/otel/trace/api/",
          "rule_status": "documented",
          "source_version": "OpenTelemetry specification 1.61.0; reviewed 2026-10-13",
          "application_limit": "An ERROR span does not identify an initiating cause. Missing spans or attributes do not prove that the operation did not happen.",
          "operations": [],
          "text_sha256": "69f88e81334e670875507dcc252dbb8f92c62b1d2362331b26bfbd037999168e",
          "scope": "Telemetry interpretation across authorized services; apply the producer's actual convention version",
          "corpus_id": "autotriager-incident-rag-v1",
          "id": "rule-span-status",
          "text": "Unset is the default span status. Error records an error in the operation; Ok records validated successful completion. Non-recording spans discard added data, and recording alone does not guarantee export to the backend.",
          "reviewed_on": "2026-10-13",
          "entity_ids": [],
          "source_section": "Set Status; IsRecording"
        }
      },
      {
        "chunk": {
          "text_kind": "paraphrase",
          "kind": "general_rule",
          "services": [],
          "graph_id": "autotriager-rag-v1",
          "title": "Trace context and parent linkage",
          "source_url": "https://opentelemetry.io/docs/specs/otel/trace/api/",
          "rule_status": "documented",
          "source_version": "OpenTelemetry specification 1.61.0; reviewed 2026-10-13",
          "application_limit": "Build parent edges from preserved IDs within a trace; a call chain is not a causal attribution chain.",
          "operations": [],
          "text_sha256": "2c7ce67bb2b5622aa55e28512bc3a69fec76f5951761461dd372b69a3cdc71a6",
          "scope": "Telemetry interpretation across authorized services; apply the producer's actual convention version",
          "corpus_id": "autotriager-incident-rag-v1",
          "id": "rule-trace-identity",
          "text": "A span has its own SpanContext, a possible parent, timing, attributes, links, and status. SpanContext carries TraceId and SpanId. Links can connect spans across traces, separately from the parent relationship.",
          "reviewed_on": "2026-10-13",
          "entity_ids": [],
          "source_section": "SpanContext, Span, Link"
        }
      },
